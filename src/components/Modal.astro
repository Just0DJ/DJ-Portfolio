<dialog class="universal-modal" id="universalModal" aria-labelledby="mTitle">
  <div class="modal-content">
    <button class="close-btn" type="button" data-modal-close aria-label="Close dialog">&times;</button>
    <div class="modal-header">
      <h2 id="mTitle">Title</h2>
      <span id="mSubtitle" class="modal-subtitle">Subtitle</span>
    </div>
    <div class="modal-image-container" id="mImageContainer">
      <img src="" alt="" id="mImage" />
    </div>
    <div class="modal-body" id="mBody"></div>
  </div>
</dialog>
