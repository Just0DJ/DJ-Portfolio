---
import { getCollection } from 'astro:content';

type ExperienceEntry = Awaited<ReturnType<typeof getCollection<'experiences'>>>[number];

interface Props {
  experiences: ExperienceEntry[];
}

const { experiences } = Astro.props;

const cards = experiences
  .slice()
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    location: 'location' in entry.data ? entry.data.location : undefined,
  }));
---

<section id="experience" class="section experience">
  <h2 class="section-title">Experience</h2>
  <div class="experience-marquee">
    <div class="experience-track">
      {
        [false, true].map((isClone) => (
          <div class="experience-group" aria-hidden={isClone ? 'true' : undefined}>
            {cards.map((card) => (
              <div
                class="experience-card"
                data-modal-open
                data-modal-id={card.id}
                data-modal-type="experience"
                role="button"
                tabindex={isClone ? -1 : 0}
                aria-haspopup="dialog"
              >
                <div>
                  <h3>{card.title}</h3>
                  <span class="experience-date">{card.date}</span>
                  {card.location && <p class="experience-location">{card.location}</p>}
                </div>
                <span class="read-more">View Details</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
