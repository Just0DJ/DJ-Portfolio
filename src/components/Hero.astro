---
import { Image } from 'astro:assets';
import { site } from '../data/content';
import pfp from '../assets/pfp.webp';
---

<section id="home" class="hero">
  <div class="hero-content">
    <div class="hero-topbar">
      <div class="hero-avatar">
        <Image src={pfp} alt={site.name} width={56} height={56} />
        <div>
          <div style="font-weight: 700; color: var(--text-color); line-height: 1.1;">Diwaakar J</div>
          <div style="font-size: 0.9rem; color: var(--text-muted);">{site.role}</div>
        </div>
      </div>

      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <a href={site.github} class="hero-theme-toggle" title="GitHub" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <a href={site.linkedin} class="hero-theme-toggle" title="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
        <a href={'mailto:' + site.email} class="hero-theme-toggle" title="Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </a>
        <button class="hero-theme-toggle" id="heroThemeToggle" type="button" aria-label="Toggle theme" title="Toggle theme">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="2"></path>
            <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div>
      <h1 style="font-size: 1rem; visibility: hidden; height: 0; margin: 0;" aria-hidden="true">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
    </div>

    <div class="hero-actions">
      <a class="btn btn-primary" href="#projects">View Projects</a>
      <a class="btn btn-secondary" href={site.resumePdf} download>Resume</a>
      <a class="btn btn-secondary" href="#contact">Contact</a>
    </div>

    <div class="hero-links" aria-label="Quick links">
      <a href="#projects">Projects</a><span class="hero-links-sep">&middot;</span>
      <a href="#skills">Skills</a><span class="hero-links-sep">&middot;</span>
      <a href="#experience">Experience</a>
    </div>
  </div>
</section>
